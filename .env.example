# Copiaza in .env si completeaza. Prefixul ROKID_ este obligatoriu; exceptii acceptate fara prefix:
# DATABASE_URL, OPENAI_API_KEY, OPENAI_MODEL, ANTHROPIC_API_KEY. Comentariile de pe linie incep cu " #".
ROKID_ENVIRONMENT=development            # production pe serverul public (dezactiveaza /api/docs)
ROKID_COOKIE_SECURE=false                # true in spatele HTTPS (Cloudflare Tunnel)
ROKID_ADMIN_USERNAME=admin
ROKID_ADMIN_PASSWORD=
ROKID_DEVICE_TOKENS=                     # tokenuri initiale pentru ochelari (scope device), separate prin virgula

# LLM: furnizorul si modelul folosite la RAG si, implicit, la citirea pozelor
ROKID_LLM_PROVIDER=openai                # mock | openai | openai_compatible | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol                 # raspunsul din documentatie: 95% pe intrebari ANR noi, ~3 s; gpt-6.1-terra: 92%, ~2,6 s
ROKID_LLM_REASONING_EFFORT=low           # none | minimal | low | medium | high; gol = nu se trimite
# ROKID_LLM_SERVICE_TIER=priority        # optional: latenta mai mica, pret mai mare

# Vedere: poza -> text, inainte de cautarea in seturile verificate
ROKID_VISION_MODEL=gpt-6.1-terra         # citeste sigur textul mic din pozele de pe ochelari (3-4 s); gpt-6-luna e mai rapid dar inventeaza la text mic
ROKID_VISION_CROP=auto                   # decupeaza ecranul luminos din poza la rezolutie completa; off = poza intreaga
ROKID_VISION_MIN_SHARPNESS=25            # pozele miscate sunt refuzate inainte de model; 0 = fara filtru
ROKID_VISION_DETAIL=high                 # auto | low | high | original
ROKID_VISION_MAX_SIDE=1792               # px pe latura lunga dupa redimensionare; 0 = fara redimensionare
ROKID_VISION_REASONING_EFFORT=none       # cel mai rapid; coborat automat daca modelul nu il accepta
# ROKID_TRANSCRIBE_CONTEXT=              # contextul de domeniu din prompt; implicit examenul ANR CAA (C/D, 3 optiuni)

# Intrebari necunoscute (nu sunt in seturile verificate): documentatie + cunostintele modelului, si cautare web in paralel
ROKID_ANSWER_GROUNDING=open              # open (implicit) | strict = doar dovezile incarcate (raspunde la 17-27% din intrebari)
ROKID_SINGLE_ANSWER=true                 # un singur raspuns corect pe intrebare (ANR)
ROKID_WEB_SEARCH_ENABLED=true            # OpenAI Responses API web_search; doar cu ROKID_LLM_PROVIDER=openai
ROKID_WEB_SEARCH_MODEL=gpt-6.1-terra     # 97-100% pe intrebari ANR, ~5,5 s, ~1 cent/apel plus tokeni
ROKID_WEB_SEARCH_TIMEOUT_SECONDS=8       # peste acest timp ramane raspunsul din documentatie
# ROKID_WEB_SEARCH_BLOCKED_DOMAINS=      # ex. forumuri, separate prin virgula; ROKID_WEB_SEARCH_ALLOWED_DOMAINS pentru lista inchisa
ROKID_CANDIDATES_ENABLED=true            # raspunsurile neverificate ajung in admin > Candidati, de unde le confirmi in setul verificat

# Embeddings pentru potrivirea semantica; schimbarea furnizorului sau a modelului cere reindexare
ROKID_EMBEDDING_PROVIDER=openai          # hash (offline, dezvoltare) | chroma_default | openai
ROKID_EMBEDDING_MODEL=text-embedding-3-small   # sau text-embedding-3-large
ROKID_ALLOW_GENERAL_KNOWLEDGE=false
ROKID_OCR_ENABLED=true                   # Tesseract ca rezerva la poze (instalat in imaginea Docker)
ROKID_LOG_LEVEL=INFO

# Baza de date: gol = SQLite in rokid_data/; Postgres: postgresql+psycopg://user:parola@host:5432/baza
DATABASE_URL=
# Cloudflare Tunnel (doar pe serverul public): Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
